{
  "C_Cpp.default.configurationProvider": "ms-vscode.makefile-tools",
  "files.associations": {
    "*.v": "bsv",
    "*.h": "c",
    "algorithm": "c",
    "limits": "c",
    "utility": "c"
  },
  "C_Cpp.autocompleteAddParentheses": true,
  "editor.formatOnSave": true,
  "editor.formatOnType": false,
  "cmake.configureOnOpen": false,
  "cSpell.words": [
    "Boxine",
    "custommodel",
    "hoverable",
    "nocloud",
    "playpause",
    "ruid",
    "teddycloud",
    "TEDDYCLOUD",
    "tonie",
    "Tonie",
    "toniebox"
  ],
}
